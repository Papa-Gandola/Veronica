{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "bot_name": "Veronica",
    "_comment": "Базовый конфиг. Секреты (ключи OKX, Telegram, пароль API) НЕ здесь — они приходят из .env через переменные FREQTRADE__*. Стратегия — в user_data/state/active.json (его переписывает brain).",

    "trading_mode": "spot",
    "margin_mode": "",
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.98,
    "max_open_trades": 3,
    "amount_reserve_percent": 0.05,
    "amend_last_stake_amount": true,
    "fiat_display_currency": "USD",

    "dry_run": true,
    "dry_run_wallet": 100,
    "cancel_open_orders_on_exit": false,

    "unfilledtimeout": {
        "entry": 20,
        "exit": 20,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },

    "exchange": {
        "name": "okx",
        "key": "",
        "secret": "",
        "password": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT",
            "SOL/USDT",
            "BNB/USDT",
            "XRP/USDT"
        ],
        "pair_blacklist": []
    },

    "pairlists": [
        {"method": "StaticPairList"}
    ],

    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": "",
        "notification_settings": {
            "status": "silent",
            "warning": "on",
            "startup": "on",
            "entry": "on",
            "entry_fill": "on",
            "entry_cancel": "silent",
            "exit": "on",
            "exit_fill": "on",
            "exit_cancel": "silent",
            "protection_trigger": "on",
            "protection_trigger_global": "on",
            "strategy_msg": "on"
        },
        "balance_dust_level": 0.01
    },

    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "",
        "ws_token": "",
        "CORS_origins": [],
        "username": "",
        "password": ""
    },

    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    },
    "dataformat_ohlcv": "feather",
    "dataformat_trades": "feather"
}
