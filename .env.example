# Скопируй в .env рядом с docker-compose.yml. Файл .env в git НЕ попадает.
# Применять изменения: docker compose up -d (restart старый env не перечитывает).

# ---------- Режим ----------
# true  = бумажная торговля (демо: виртуальный кошелёк, реальные цены OKX)
# false = реальные деньги. Переключать ТОЛЬКО осознанно, см. README.
DRY_RUN=true

# ---------- OKX ----------
# Ключ создаётся в OKX → API → Create API key.
# Права: ТОЛЬКО "Read" + "Trade". Галочку "Withdraw" НЕ ставить.
# Для режима dry ключи не нужны вообще — оставь пустыми.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ---------- Telegram ----------
# Токен от @BotFather, chat_id — свой (узнать через @userinfobot).
# TELEGRAM_ENABLED=true включает Telegram-бота freqtrade (команды + уведомления).
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Внутренний REST API freqtrade (brain ходит в него) ----------
# Любые случайные строки. Наружу порт не светится.
FT_API_USERNAME=veronica
FT_API_PASSWORD=change-me-random
FT_JWT_SECRET=change-me-openssl-rand-hex-32
FT_WS_TOKEN=change-me-random

# ---------- Claude (разбор дневника раз в сутки) ----------
# Ключ с console.anthropic.com. Пусто = разбор выключен, остальное работает.
ANTHROPIC_API_KEY=
# Модель для разбора. По умолчанию claude-opus-5-5 (~2-4$/мес при одном разборе в сутки).
CLAUDE_MODEL=claude-opus-5-5

# ---------- GandolaChat ----------
# Veronica — обычный пользователь чата. Зарегистрируй её, одобри как админ,
# добавь в нужный чат и впиши id этого чата.
GANDOLA_API_URL=
GANDOLA_USERNAME=
GANDOLA_PASSWORD=
GANDOLA_CHAT_ID=

# ---------- Риск ----------
# Просадка от стартового капитала, при которой торговля останавливается
# и Veronica ждёт команды /resume. 0.40 = 40%.
MAX_DRAWDOWN=0.40
# Дневной лимит убытка (доля от капитала), после которого новые входы
# запрещены до следующего дня UTC.
MAX_DAILY_LOSS=0.08
# Стартовый капитал в USDT (для расчёта просадки). В dry-режиме = виртуальный кошелёк.
INITIAL_CAPITAL=100

# ---------- Расписание ----------
# Час (UTC), в который делается вечерний отчёт и разбор. 17 UTC = 20:00 МСК.
REPORT_HOUR_UTC=17
# Часовой пояс для текста отчётов.
REPORT_TZ=Europe/Moscow
